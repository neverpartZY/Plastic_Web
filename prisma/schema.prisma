generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── 用户 ─────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String
  name         String
  avatarUrl    String?
  role         String   @default("user")
  isPremium    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dashboards    Dashboard[]
  bookmarks     Bookmark[]
  subscriptions Subscription[]

  @@index([email])
  @@index([phone])
}

// ─── 标签 ─────────────────────────────────────────────────────────────────────

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  /// entity | application | material | process | technology | region | topic
  category  String
  color     String   @default("#6B7280")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  newsItems     NewsTag[]
  dashboardTags DashboardTag[]

  @@index([category])
}

// ─── 行业资讯 ─────────────────────────────────────────────────────────────────

model News {
  id          String  @id @default(cuid())
  title       String
  summary     String
  content     String
  coverImage  String?
  source      String?
  sourceUrl   String?
  author      String?
  viewCount   Int     @default(0)
  isPublished Boolean @default(true)

  /// draft | published | archived
  status String @default("published")

  /// ai | manual | scraper
  dataSource String @default("manual")

  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tags      NewsTag[]
  bookmarks Bookmark[]

  @@index([publishedAt])
  @@index([viewCount])
  @@index([isPublished])
  @@index([status])
  @@index([dataSource])
}

model NewsTag {
  newsId String
  tagId  String

  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([newsId, tagId])
  @@index([tagId])
}

// ─── 用户看板 ─────────────────────────────────────────────────────────────────

model Dashboard {
  id        String   @id @default(cuid())
  userId    String
  name      String
  isDefault Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags DashboardTag[]

  @@index([userId])
}

model DashboardTag {
  dashboardId String
  tagId       String

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([dashboardId, tagId])
}

// ─── 收藏 ─────────────────────────────────────────────────────────────────────

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  newsId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([userId, newsId])
  @@index([userId])
}

// ─── 产业地图 ────────────────────────────────────────────────────────────────

model Company {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  logo        String?
  description String?
  website     String?

  /// X轴实体维度: equipment | additive | mold | process | material
  entityType String

  /// Y轴应用领域: automotive | electronics | packaging | construction | medical | agriculture
  appDomain String

  /// 处理能力 (吨/年)
  capacity Int?

  /// 回收率 (0–100)
  recycleRate Float?

  province   String?
  city       String?
  isVerified Boolean  @default(false)
  isPremium  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  intelligenceLinks IntelligenceCompany[]

  @@index([entityType])
  @@index([appDomain])
  @@index([province])
}

// ─── 采集源配置 ──────────────────────────────────────────────────────────────

model CrawlSource {
  id            String    @id @default(cuid())
  name          String    @unique
  url           String
  /// p0 | p1 | p2 | p3
  priority      String    @default("p2")
  /// zh | en
  lang          String    @default("zh")
  /// news | price | policy | standard
  contentType   String    @default("news")
  /// active | paused | error
  status        String    @default("active")
  lastCrawledAt DateTime?
  crawlCount    Int       @default(0)
  errorCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  intelligenceItems Intelligence[]

  @@index([priority])
  @@index([status])
  @@index([lang])
}

// ─── 每日情报 ────────────────────────────────────────────────────────────────

model Intelligence {
  id      String @id @default(cuid())
  title   String
  summary String
  content String @default("")

  /// 原始语言 title（供翻译后对照）
  titleZh   String?
  titleEn   String?
  summaryZh String?
  summaryEn String?

  /// 正文中文翻译（GLM 翻译，供中文读者阅读）
  contentZh String?

  /// GLM 生成的 TLDR — 3条要点，每条以 • 开头
  tldrZh String?
  tldrEn String?

  /// policy | market | tech | enterprise | global
  category String

  /// 7大战略维度: molds | molding | materials | additives | auxiliaries | recycling | reuse
  /// 逗号分隔，支持多维度
  pillars String?

  /// 国家/地区代码 CN | EU | US | UK | GLOBAL
  countryCode String?

  /// 重要性 1-5（AI评分，5=最高）
  importance Int @default(3)

  /// pending | translated | failed
  translateStatus String @default("pending")

  source        String?
  sourceUrl     String?
  crawlSourceId String?
  isHot         Boolean  @default(false)
  isPremium     Boolean  @default(false)
  publishedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  crawlSource    CrawlSource?          @relation(fields: [crawlSourceId], references: [id], onDelete: SetNull)
  companyLinks   IntelligenceCompany[]
  versions       IntelligenceVersion[]

  /// ── Task 2 扩展字段 ────────────────────────────────────────────────────────
  /// URL SHA256 前32位，用于去重（唯一索引）
  urlHash     String   @unique
  /// 指向原始语言情报ID（如英文章指向中文翻译，反之亦然）
  originalId  String?
  /// 人工审核后版本号（每次修改+1）
  version     Int      @default(1)
  /// 7维度 Enum（冗余存储，查询方便）
  dimension   String?
  /// 区域
  region      String?
  /// 标签数组
  tags        String[] @default([])
  /// 语言
  lang        String   @default("en")
  /// AI翻译标题
  translatedTitle String?

  @@index([publishedAt])
  @@index([category])
  @@index([isHot])
  @@index([pillars])
  @@index([countryCode])
  @@index([importance])
  @@index([translateStatus])
  @@index([urlHash])
  @@index([originalId])
}

// ─── 情报版本历史（人工审核追踪）────────────────────────────────────────────

model IntelligenceVersion {
  id             String   @id @default(cuid())
  intelligenceId String
  version        Int      // 版本号，首次创建为1，人工修改后+1
  title          String
  summary        String
  content        String   @default("")
  dimension      String?
  region         String?
  importance     Int      @default(3)
  tags           String[] @default([])
  editedBy       String?  // 审核人邮箱
  editNote       String?  // 修改说明
  createdAt      DateTime @default(now())

  intelligence   Intelligence @relation(fields: [intelligenceId], references: [id], onDelete: Cascade)

  @@index([intelligenceId, version])
}

// ─── 情报↔企业关联 ───────────────────────────────────────────────────────────

model IntelligenceCompany {
  intelligenceId String
  companyId      String
  /// 关联强度 0.0-1.0（AI计算）
  relevanceScore Float  @default(0.5)

  intelligence Intelligence @relation(fields: [intelligenceId], references: [id], onDelete: Cascade)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([intelligenceId, companyId])
  @@index([companyId])
}

// ─── 订阅 ─────────────────────────────────────────────────────────────────────

model Subscription {
  id          String   @id @default(cuid())
  userId      String?
  email       String?
  phone       String?
  channel     String   @default("email") // email|wechat|feishu|webhook
  interests   String[] @default([])      // 订阅的维度/标签数组
  frequency   String   @default("daily") // realtime|daily|weekly
  webhookUrl  String?                  // Webhook地址
  lastSentAt  DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  pushLogs PushLog[]

  @@index([userId])
  @@index([channel])
  @@index([isActive])
}

// ─── 推送日志 ────────────────────────────────────────────────────────────────

model PushLog {
  id             String   @id @default(cuid())
  subscriptionId String
  intelligenceId String
  status         String   // sent|failed|webhook_error
  response       String?  // Webhook响应内容
  error          String?  // 错误信息
  createdAt      DateTime @default(now())

  subscription  Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@index([intelligenceId])
}

// ─── 订阅者 ──────────────────────────────────────────────────────────────────

model Subscriber {
  id    String  @id @default(cuid())
  email String? @unique
  phone String? @unique
  name  String?

  /// email | wechat | feishu | whatsapp
  channel String @default("email")

  /// comma-separated tag slugs for interest matching
  interests String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([channel])
}

// ─── 行业服务 ────────────────────────────────────────────────────────────────

model ServiceReport {
  id          String   @id @default(cuid())
  title       String
  summary     String
  category    String   /// research | whitepaper | guide | compliance
  author      String?
  pages       Int?
  isPremium   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPremium])
}

model ServiceEvent {
  id          String    @id @default(cuid())
  title       String
  description String
  /// conference | exhibition | seminar | workshop
  eventType   String
  location    String
  city        String
  startDate   DateTime
  endDate     DateTime?
  capacity    Int?
  status      String    @default("open") /// open | closed | full | cancelled
  isPremium   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  applications ServiceApplication[]

  @@index([startDate])
  @@index([status])
}

model ServiceApplication {
  id String @id @default(cuid())

  // Applicant
  name    String
  company String?
  email   String
  phone   String?

  /// report_request | association_join | event_register | tech_apply | fund_apply
  type String

  // Relations
  eventId String?
  event   ServiceEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  /// Extra fields as JSON string (project name, funding stage, etc.)
  metadata String?

  status    String   @default("pending") /// pending | approved | rejected
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([email])
  @@index([status])
  @@index([eventId])
}
