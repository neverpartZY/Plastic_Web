generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url  	    = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String?     @unique
  phone        String?     @unique
  passwordHash String
  name         String
  avatarUrl    String?
  role         String      @default("user")
  isPremium    Boolean     @default(false)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  dashboards   Dashboard[]
  bookmarks    Bookmark[]

  @@index([email])
  @@index([phone])
}

model Tag {
  id            String         @id @default(cuid())
  name          String         @unique
  slug          String         @unique
  /// entity | application | material | process | technology | region | topic
  category      String
  color         String         @default("#6B7280")
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())

  newsItems     NewsTag[]
  dashboardTags DashboardTag[]

  @@index([category])
}

model News {
  id          String    @id @default(cuid())
  title       String
  summary     String
  content     String
  coverImage  String?
  source      String?   // Media source name (e.g. "环球塑化网")
  sourceUrl   String?
  author      String?
  viewCount   Int       @default(0)
  isPublished Boolean   @default(true)

  /// draft | published | archived
  status      String    @default("published")

  /// ai | manual | scraper
  dataSource  String    @default("manual")

  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tags        NewsTag[]
  bookmarks   Bookmark[]

  @@index([publishedAt])
  @@index([viewCount])
  @@index([isPublished])
  @@index([status])
  @@index([dataSource])
}

model NewsTag {
  newsId String
  tagId  String

  news   News @relation(fields: [newsId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([newsId, tagId])
  @@index([tagId])
}

model Dashboard {
  id        String         @id @default(cuid())
  userId    String
  name      String
  isDefault Boolean        @default(false)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags      DashboardTag[]

  @@index([userId])
}

model DashboardTag {
  dashboardId String
  tagId       String

  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([dashboardId, tagId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  newsId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([userId, newsId])
  @@index([userId])
}

// ─── 产业地图 ────────────────────────────────────────────────────────────────

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  description String?
  website     String?

  /// X轴实体维度: equipment | additive | mold | process | material
  entityType  String

  /// Y轴应用领域: automotive | electronics | packaging | construction | medical | agriculture
  appDomain   String

  /// 处理能力 (吨/年)
  capacity    Int?

  /// 回收率 (0–100)
  recycleRate Float?

  province    String?
  city        String?
  isVerified  Boolean  @default(false)
  isPremium   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([entityType])
  @@index([appDomain])
  @@index([province])
}

// ─── 每日情报 ────────────────────────────────────────────────────────────────

model Intelligence {
  id          String   @id @default(cuid())
  title       String
  summary     String
  content     String   @default("")

  /// policy | market | tech | enterprise | global
  category    String

  source      String?
  sourceUrl   String?
  isHot       Boolean  @default(false)
  isPremium   Boolean  @default(false)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishedAt])
  @@index([category])
  @@index([isHot])
}

// ─── 订阅者 ──────────────────────────────────────────────────────────────────

model Subscriber {
  id        String   @id @default(cuid())
  email     String?  @unique
  phone     String?  @unique
  name      String?

  /// email | wechat | feishu | whatsapp
  channel   String   @default("email")

  /// comma-separated tag slugs for interest matching
  interests String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([channel])
}

// ─── 行业服务 ────────────────────────────────────────────────────────────────

model ServiceReport {
  id          String   @id @default(cuid())
  title       String
  summary     String
  category    String   /// research | whitepaper | guide | compliance
  author      String?
  pages       Int?
  isPremium   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPremium])
}

model ServiceEvent {
  id          String    @id @default(cuid())
  title       String
  description String
  /// conference | exhibition | seminar | workshop
  eventType   String
  location    String
  city        String
  startDate   DateTime
  endDate     DateTime?
  capacity    Int?
  status      String    @default("open") /// open | closed | full | cancelled
  isPremium   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  applications ServiceApplication[]

  @@index([startDate])
  @@index([status])
}

model ServiceApplication {
  id      String  @id @default(cuid())

  // Applicant
  name    String
  company String?
  email   String
  phone   String?

  /// report_request | association_join | event_register | tech_apply | fund_apply
  type    String

  // Relations
  eventId String?
  event   ServiceEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  /// Extra fields as JSON string (project name, funding stage, etc.)
  metadata String?

  status  String   @default("pending") /// pending | approved | rejected
  note    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([email])
  @@index([status])
  @@index([eventId])
}
